{
  "name": "@enreign/productboard-mcp",
  "version": "0.3.0",
  "description": "MCP server for Productboard API integration",
  "main": "dist/index.js",
  "bin": "./productboard-mcp.js",
  "files": [
    "productboard-mcp.js",
    "dist",
    "config",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/fix-imports.js && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "TEST_TYPE=e2e jest --config jest.config.e2e.js --runInBand",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "productboard",
    "api",
    "typescript",
    "model-context-protocol",
    "ai-assistant",
    "integration"
  ],
  "author": "Stanislav Shymanskyi <taysic@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Enreign/productboard-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Enreign/productboard-mcp/issues"
  },
  "homepage": "https://github.com/Enreign/productboard-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "1.20.0",
    "dotenv": "^18.0.7",
    "jsonschema": "^1.4.1",
    "lru-cache": "^11.5.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "overrides": {
    "ajv": "^8.17.1",
    "eslint": {
      "ajv": "^6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "minimatch": ">=9.0.7",
    "js-yaml": "4.2.0",
    "form-data": ">=4.0.6",
    "hono": ">=4.12.27",
    "@hono/node-server": ">=1.19.10",
    "express-rate-limit": ">=8.2.2",
    "@babel/core": "7.29.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "glob": "^13.0.6",
    "jest": "^30.5.2",
    "nock": "^15.0.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
